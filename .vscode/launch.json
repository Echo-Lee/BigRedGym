{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Play Go2 (viewer)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/mjpython"
            },
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "program": "${workspaceFolder}/scripts/play.py",
            "args": [
                "--task=go2trot",
                "--device=cpu",
                "--experiment_name=go2trot",
                "--load_run=Oct15_03-06-29_",
                "--checkpoint=-1",
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
